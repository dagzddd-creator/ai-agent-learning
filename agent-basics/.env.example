# ============================================================
# 大模型服务商配置模板（OpenAI 兼容接口通用）
#
# ⚠️ 使用步骤：
#   1. 复制本文件为 .env（不要直接改本文件！）
#   2. 在 .env 里填入你的 key
#   3. .env 已被 .gitignore 忽略，不会泄露到 GitHub
# ============================================================

# 【基元律动 TokenRhythm】https://tokenrhythm.studio
# 注册（手机号）后立即保存页面展示的一次性完整 API Key（只显示一次！）
LLM_API_KEY=sk_tr_在这里填你的key

# 基元律动统一接入地址（官方文档「快速开始」）
LLM_BASE_URL=https://tokenrhythm.studio/v1

# 模型名：从 https://tokenrhythm.studio/models 挑选【支持工具调用】的模型
# 推荐：deepseek-v4-flash-0731（便宜）或 glm-5.2 / qwen3.7-flash
# 若报 MODEL_TOOL_NOT_SUPPORTED = 该模型不支持工具调用，换一个即可
LLM_MODEL=deepseek-v4-flash-0731

# ============================================================
# 其他服务商示例（同样格式，换服务商只改这三个变量）：
#
#  DeepSeek 官方：LLM_BASE_URL=https://api.deepseek.com   LLM_MODEL=deepseek-chat
#  通义百炼：     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# ============================================================
